{
  "name": "blood-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:launch": "playwright test tests/phase0-launch.spec.ts",
    "test:e2e:phase8": "playwright test tests/phase8-playtest.spec.ts",
    "test:e2e:phase8:2": "playwright test tests/phase8-playtest.spec.ts -g \"2 joueurs\"",
    "test:e2e:phase8:3": "playwright test tests/phase8-playtest.spec.ts -g \"3 joueurs\"",
    "test:e2e:phase8:4": "playwright test tests/phase8-playtest.spec.ts -g \"4 joueurs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "publish:archive": "npm run build && mkdir -p release && tar -czf release/blood-relay-${npm_package_version}.tar.gz -C dist ."
  },
  "dependencies": {
    "phaser": "^3.86.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.22.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.5"
  }
}
